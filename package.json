{
  "name": "valorant-crosshair-collector",
  "version": "0.1.0",
  "description": "无畏契约（Valorant）准星收集软件",
  "main": "main.js",
  "author": "Crosshair Collector",
  "license": "MIT",
  "scripts": {
    "start": "node start.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.crosshair.collector",
    "productName": "无畏契约准星收集",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "data/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
